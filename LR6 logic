}



package com.example.lr16;

import androidx.appcompat.app.AppCompatActivity;
import android.os.Bundle;
import android.view.Window;
import android.widget.TextView;

public class Exercise1Activity extends AppCompatActivity {
    @Override
    protected void onCreate(Bundle savedInstanceState) {
        super.onCreate(savedInstanceState);
        setContentView(R.layout.activity_ex1);

        // 1. Строковый массив
        TextView textString = findViewById(R.id.text_string);
        String[] names = getResources().getStringArray(R.array.names);
        StringBuilder sbString = new StringBuilder();
        for (String name : names) {
            sbString.append(name).append("\n");
        }
        textString.setText(sbString.toString());

        // 2. Числовой массив
        TextView textDigits = findViewById(R.id.text_digit);
        int[] digits = getResources().getIntArray(R.array.digits);
        StringBuilder sbDigits = new StringBuilder();
        for (int i = 0; i < digits.length; i++) {
            sbDigits.append("Name[").append(i).append("]:").append(digits[i]).append("\n");
        }
        textDigits.setText(sbDigits.toString());

        // 3. Стили и цвета
        TextView textStyle = findViewById(R.id.text_style);
        textStyle.setText(getResources().getString(R.string.some_text));
        textStyle.setTextColor(getResources().getColor(R.color.textColor, getTheme()));
        textStyle.setTextSize(android.util.TypedValue.COMPLEX_UNIT_PX, getResources().getDimension(R.dimen.TextPointSize));
        textStyle.setBackgroundColor(getResources().getColor(R.color.backgroundColor, getTheme()));

        // 4. Фон окна
        Window w = getWindow();
        w.setBackgroundDrawable(getResources().getDrawable(R.drawable.grayDrawable, getTheme()));
    }
}




package com.example.lr16;

import androidx.appcompat.app.AppCompatActivity;
import android.os.Bundle;
import android.widget.TextView;
import java.io.DataInputStream;
import java.io.InputStream;

public class Exercise2Activity extends AppCompatActivity {
    @Override
    protected void onCreate(Bundle savedInstanceState) {
        super.onCreate(savedInstanceState);
        setContentView(R.layout.activity_ex2);

        TextView text = findViewById(R.id.text);
        InputStream iFile = getResources().openRawResource(R.raw.test);
        try {
            StringBuilder sBuffer = new StringBuilder();
            DataInputStream dataIO = new DataInputStream(iFile);
            String strLine = null;
            while ((strLine = dataIO.readLine()) != null) {
                sBuffer.append(strLine).append("\n");
            }
            dataIO.close();
            iFile.close();
            text.setText(sBuffer.toString());
        } catch (Exception e) {
            text.setText("Error loading file: " + e.getMessage());
        }
    }
}




package com.example.lr16;

import androidx.appcompat.app.AppCompatActivity;
import android.os.Bundle;
import android.widget.TextView;
import android.widget.Toast;
import org.xmlpull.v1.XmlPullParser;

public class Exercise3Activity extends AppCompatActivity {
    @Override
    protected void onCreate(Bundle savedInstanceState) {
        super.onCreate(savedInstanceState);
        setContentView(R.layout.activity_ex3);

        TextView text = findViewById(R.id.text);
        StringBuilder data = new StringBuilder();
        try {
            XmlPullParser parser = getResources().getXml(R.xml.contacts);
            
            while (parser.getEventType() != XmlPullParser.END_DOCUMENT) {
                if (parser.getEventType() == XmlPullParser.START_TAG &&
                        parser.getName().equals("contact")) {
                    
                    String firstName = parser.getAttributeValue(null, "first_name");
                    String lastName = parser.getAttributeValue(null, "last_name");
                    String phone = parser.getAttributeValue(null, "phone");
                    
                    data.append(firstName).append(" ")
                        .append(lastName).append(": ")
                        .append(phone).append("\n");
                }
                parser.next();
            }
            text.setText(data.toString());
        } catch (Throwable t) {
            Toast.makeText(this, "Error: " + t.toString(), Toast.LENGTH_LONG).show();
        }
    }
}
