namespace WpfApp1
{
    public class Product
    {
        public string Name { get; set; }
        public string Category { get; set; }
        public decimal Price { get; set; }
        public string ImageUrl { get; set; }
    }
}



using System.Collections.ObjectModel;

namespace WpfApp1
{
    public class MainViewModel
    {
        public string AppTitle { get; set; } = "Каталог продуктов";
        
        public ObservableCollection<Product> Products { get; set; }

        public MainViewModel()
        {
            Products = new ObservableCollection<Product>
            {
                new Product { Name = "Молоко 3.2%", Category = "Молочные продукты", Price = 85.50m, ImageUrl = "https://via.placeholder.com/150?text=Milk" },
                new Product { Name = "Хлеб Бородинский", Category = "Хлеб/выпечка", Price = 45.00m, ImageUrl = "https://via.placeholder.com/150?text=Bread" },
                new Product { Name = "Яблоки Голден", Category = "Овощи и фрукты", Price = 120.00m, ImageUrl = "https://via.placeholder.com/150?text=Apples" },
                new Product { Name = "Сок Добрый", Category = "Напитки", Price = 110.00m, ImageUrl = "https://via.placeholder.com/150?text=Juice" },
                new Product { Name = "Шоколад Аленка", Category = "Сладости", Price = 99.90m, ImageUrl = "https://via.placeholder.com/150?text=Chocolate" }
            };
        }
    }
}



<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WpfApp1"
        Title="MainWindow" Height="600" Width="800" WindowStartupLocation="CenterScreen">

    <!-- Привязываем DataContext к нашей ViewModel -->
    <Window.DataContext>
        <local:MainViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Название приложения -->
        <TextBlock Text="{Binding AppTitle}" 
                   FontSize="28" FontWeight="Bold" 
                   HorizontalAlignment="Center" Margin="20" Foreground="#333"/>

        <!-- Сетка продуктов -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="10">
            <ItemsControl ItemsSource="{Binding Products}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#DDD" BorderThickness="1" CornerRadius="8" 
                                Margin="10" Padding="10" Width="200" Background="#FAFAFA">
                            <StackPanel>
                                <Image Source="{Binding ImageUrl}" Height="150" Margin="0,0,0,10" Stretch="Uniform"/>
                                
                                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold" 
                                           TextWrapping="Wrap" HorizontalAlignment="Center"/>
                                
                                <TextBlock Text="{Binding Category}" FontSize="12" Foreground="#666" 
                                           HorizontalAlignment="Center" Margin="0,5,0,10"/>
                                
                                <TextBlock Text="{Binding Price, StringFormat={}{0:C}}" 
                                           FontSize="18" FontWeight="Bold" Foreground="#E91E63" 
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>
